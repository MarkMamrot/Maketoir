    "google-ads-api": "^23.0.0",
    "googleapis": "^134.0.0",
    "jsbarcode": "^3.12.3",
    "jstat": "^1.9.6",
    "lucide-react": "^1.27.0",
    "mysql2": "^3.22.3",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4",
    "shopify-api-node": "^3.12.3"
  },
