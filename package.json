{
  "name": "marketoir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e:live:preflight": "playwright test --project=live-monsterthreads --grep @preflight",
    "e2e:live:p1": "playwright test --project=live-monsterthreads --grep \"^@p1-(create|receive) \"",
    "e2e:live:p1:create": "playwright test --project=live-monsterthreads --grep @p1-create",
    "e2e:live:p1:receive": "playwright test --project=live-monsterthreads --grep @p1-receive",
    "e2e:live:p1:repair": "playwright test --project=live-monsterthreads --grep @p1-repair",
    "e2e:live:p1:compensate": "playwright test --project=live-monsterthreads --grep @p1-compensate",
    "e2e:live:p1:recover": "tsx e2e/live-monsterthreads/recover-interrupted-p1.ts",
    "e2e:live:p1:retry-compensation": "tsx e2e/live-monsterthreads/controller.ts retry-compensation",
    "e2e:live:list": "playwright test --project=live-monsterthreads --list",
    "e2e:live:fixtures": "node scripts/live-e2e-inspect-fixtures.mjs",
    "e2e:live:gate": "tsx e2e/live-monsterthreads/controller.ts",
    "e2e:report": "playwright show-report test-results/playwright-report",
    "brand:export": "node scripts/export-solvantis-logo.mjs"
  },
  "dependencies": {
    "@google-analytics/data": "^5.2.1",
