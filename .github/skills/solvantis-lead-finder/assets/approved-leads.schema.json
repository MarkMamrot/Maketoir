{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solvantis approved lead import",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "kind": { "enum": ["centre_directory", "official_website", "web_search", "maps", "other"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateKey", "batchId", "sourceQuery", "name", "discoveredAt", "sources"],
      "anyOf": [
        { "required": ["email"] },
        { "required": ["phone"] },
        { "required": ["mobile"] },
        { "required": ["website_url"] },
        { "required": ["address"] }
      ],
      "properties": {
        "candidateKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "batchId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceQuery": { "type": "string", "minLength": 1, "maxLength": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "company": { "type": ["string", "null"], "maxLength": 255 },
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "mobile": { "type": ["string", "null"] },
        "website_url": { "type": ["string", "null"], "format": "uri" },
        "address": { "type": ["string", "null"] },
        "address2": { "type": ["string", "null"] },
        "suburb": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "postcode": { "type": ["string", "null"] },
        "country": { "const": "Australia" },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    }
  }
}